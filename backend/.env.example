# ============================================================
# Sistema de Repuestos - Backend (.env de ejemplo)
# Copie este archivo como .env y ajuste los valores.
# ============================================================

NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=repuestos
DATABASE_PASSWORD=repuestos_secret
DATABASE_NAME=repuestos_db
DATABASE_POOL_MAX=10
DATABASE_RETRY_ATTEMPTS=30
DATABASE_RETRY_DELAY=2000
DATABASE_CONNECTION_TIMEOUT=15000

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-32chars
JWT_REFRESH_SECRET=change-me-refresh-secret-32chars
JWT_ACCESS_EXPIRES=365d
JWT_REFRESH_EXPIRES=365d

# CORS
CORS_ORIGINS=http://localhost:4200

# Redis (opcional; si no está definida, cache=memoria y colas=inline)
REDIS_URL=redis://localhost:6379

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=1000

# Firebase Cloud Messaging (OPCIONAL; sin esto el push se ignora silenciosamente)
# Pegue aquí el JSON completo de "Service accounts" de Firebase, escapado.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
